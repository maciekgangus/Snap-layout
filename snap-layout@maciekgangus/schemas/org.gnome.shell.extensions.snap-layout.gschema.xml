<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.snap-layout"
          path="/org/gnome/shell/extensions/snap-layout/">

    <key name="snap-left-half" type="as">
      <default><![CDATA[['<Super>Left']]]></default>
      <summary>Snap: left half</summary>
    </key>
    <key name="snap-right-half" type="as">
      <default><![CDATA[['<Super>Right']]]></default>
      <summary>Snap: right half</summary>
    </key>
    <key name="snap-top-half" type="as">
      <default><![CDATA[['<Super><Alt>Up']]]></default>
      <summary>Snap: top half</summary>
    </key>
    <key name="snap-bottom-half" type="as">
      <default><![CDATA[['<Super><Alt>Down']]]></default>
      <summary>Snap: bottom half</summary>
    </key>
    <key name="snap-top-left" type="as">
      <default>[]</default>
      <summary>Snap: top-left quarter</summary>
    </key>
    <key name="snap-top-right" type="as">
      <default>[]</default>
      <summary>Snap: top-right quarter</summary>
    </key>
    <key name="snap-bottom-left" type="as">
      <default>[]</default>
      <summary>Snap: bottom-left quarter</summary>
    </key>
    <key name="snap-bottom-right" type="as">
      <default>[]</default>
      <summary>Snap: bottom-right quarter</summary>
    </key>
    <key name="snap-maximize" type="as">
      <default><![CDATA[['<Super>Up']]]></default>
      <summary>Snap: maximize</summary>
    </key>
    <key name="snap-restore" type="as">
      <default><![CDATA[['<Super>Down']]]></default>
      <summary>Snap: restore / unmaximize</summary>
    </key>
    <key name="snap-left-third" type="as">
      <default><![CDATA[['<Super><Alt>Left']]]></default>
      <summary>Snap: left 1/3</summary>
    </key>
    <key name="snap-right-third" type="as">
      <default><![CDATA[['<Super><Alt>Right']]]></default>
      <summary>Snap: right 1/3</summary>
    </key>
    <key name="snap-left-two-thirds" type="as">
      <default><![CDATA[['<Super><Control>Left']]]></default>
      <summary>Snap: left 2/3</summary>
    </key>
    <key name="snap-right-two-thirds" type="as">
      <default><![CDATA[['<Super><Control>Right']]]></default>
      <summary>Snap: right 2/3</summary>
    </key>
    <key name="move-monitor-left" type="as">
      <default><![CDATA[['<Super><Shift>Left']]]></default>
      <summary>Move window to left monitor</summary>
    </key>
    <key name="move-monitor-right" type="as">
      <default><![CDATA[['<Super><Shift>Right']]]></default>
      <summary>Move window to right monitor</summary>
    </key>
    <key name="focus-monitor-left" type="as">
      <default><![CDATA[['<Super><Shift><Alt>Left']]]></default>
      <summary>Focus left monitor</summary>
    </key>
    <key name="focus-monitor-right" type="as">
      <default><![CDATA[['<Super><Shift><Alt>Right']]]></default>
      <summary>Focus right monitor</summary>
    </key>

    <key name="cycle-snapping" type="b">
      <default>false</default>
      <summary>Cycle snap positions</summary>
      <description>When enabled, Super+Left and Super+Right cycle through half, third, and two-thirds on repeated presses.</description>
    </key>

    <key name="layouts" type="s">
      <default>'{}'</default>
      <summary>Saved window layouts</summary>
      <description>JSON: per-monitor, per-slot arrays of window geometry. Keyed by monitor resolution and position.</description>
    </key>

    <key name="layout-save-1" type="as">
      <default><![CDATA[['<Super><Control><Shift>1']]]></default>
      <summary>Save layout to slot 1</summary>
    </key>
    <key name="layout-save-2" type="as">
      <default><![CDATA[['<Super><Control><Shift>2']]]></default>
      <summary>Save layout to slot 2</summary>
    </key>
    <key name="layout-save-3" type="as">
      <default><![CDATA[['<Super><Control><Shift>3']]]></default>
      <summary>Save layout to slot 3</summary>
    </key>
    <key name="layout-restore-1" type="as">
      <default><![CDATA[['<Super><Control>1']]]></default>
      <summary>Restore layout from slot 1</summary>
    </key>
    <key name="layout-restore-2" type="as">
      <default><![CDATA[['<Super><Control>2']]]></default>
      <summary>Restore layout from slot 2</summary>
    </key>
    <key name="layout-restore-3" type="as">
      <default><![CDATA[['<Super><Control>3']]]></default>
      <summary>Restore layout from slot 3</summary>
    </key>

  </schema>
</schemalist>
